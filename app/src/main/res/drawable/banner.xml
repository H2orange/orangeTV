<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 启动器横幅占位图，正式发布请替换为 320x180 的 PNG -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1A0E0A"
                android:endColor="#07090D" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                android:width="72dp"
                android:height="72dp" />
            <solid android:color="#FF8256" />
        </shape>
    </item>
</layer-list>
